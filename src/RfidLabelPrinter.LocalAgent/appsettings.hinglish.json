{
  "AgentSettings": {
    // Cloud Server ka API URL jahan se pending print jobs claim hote hain aur status report hota hai
    "CloudApiUrl": "http://180.151.91.194:7000/api/print-jobs",
    // Zebra RFID printer ka local network IP address (jaise 192.168.29.180)
    "PrinterIp": "192.168.29.180",
    // Zebra printer ka network port number (Standard Zebra port 9100 hota hai)
    "PrinterPort": 9100,
    // Naye print jobs check karne ka time milliseconds mein (300ms = 0.3 second)
    "PollingIntervalMs": 300,
    // Ek baar mein cloud se kitne print jobs uthane hain (1 job at a time standard hai)
    "ClaimBatchSize": 1,
    // Lagatar kitni baar jobs process karke thoda sa pause lena hai
    "ClaimMaxLoopsPerCycle": 10,
    // RFID tag mein data write karna hai toh true rakhein, sirf normal print ke liye false
    "EnableRfidWrite": true,
    // Zebra printer head ka resolution (300 DPI printer ke liye 300 rakhein)
    "PrinterDpi": 300,
    // Label ki poori physical chaudai dots mein (100mm label ke liye 300 DPI pe 1181 dots)
    "LabelWidthDots": 1181,
    // Label ki poori physical lambai dots mein (50mm label ke liye 300 DPI pe 591 dots)
    "LabelLengthDots": 591,
    // Photo ko Left/Right karne ke liye (725 se right flap ke middle mein aayega, badhane se Right jayega, ghatane se Left)
    "PrintOffsetX": 725,
    // Photo ko Upar/Neeche karne ke liye (135 se vertically middle mein aayega, badhane se Neeche jayega, ghatane se Upar)
    "PrintOffsetY": 135,
    // Right flap ki fixed chaudai (0 rakhenge toh Fold Line se aakhri kinare tak automatic lega)
    "PrintAreaWidthDots": 0,
    // Right flap ki fixed unchai (0 rakhenge toh poori label height automatic lega)
    "PrintAreaHeightDots": 0,
    // Agar automatic flap ke center mein fit karna ho toh true, manual X/Y offset use karna ho toh false
    "AutoCenterOnFlap": false,
    // Photo ko Chhota/Bada karne ke liye (55% compact hai, aur chhota karna ho toh 50 ya 45 karein)
    "PdfSizePercent": 55,
    // PDF ke charo taraf ka bekar safed space apne aap kaatne ke liye true rakhein
    "AutoTrimWhitespace": true,
    // PDF ko sharp clear graphic bitmap bana kar print karne ke liye true rakhein
    "PrintPdfAsGraphics": true,
    // Native ZPL font use karna ho toh true, design jaisa PDF print karna ho toh false
    "PreferPdfTextToZpl": false,
    // Zebra hardware ka physical feed shift (-120 se +120 dots, 0 standard hai)
    "LabelTopShiftDots": 0,
    // PDF ko image mein convert karne ka resolution (300 DPI best aur sharp quality deta hai)
    "PdfRenderDpi": 300,
    // Kaali ink ka dark level (0-255) - 240 pe halka text bhi saaf aur solid aayega
    "BlackThreshold": 240,
    // Transparency check (0-255) - 5 pe har printable ink capture hoti hai
    "AlphaThreshold": 5,
    // Agar remote PDF download fail ho toh kitni baar dobara koshish karni hai
    "PdfDownloadRetryCount": 5,
    // Download retry ke beech kitna intezar karna hai milliseconds mein
    "PdfDownloadRetryDelayMs": 800,
    // RFID memory format: "H" Hexadecimal ke liye (Standard), "A" ASCII text ke liye
    "RfidMode": "H",
    // RFID memory bank number: 1 = EPC memory bank (Standard Gen2 RFID specification)
    "RfidBlockNumber": 1,
    // EPC bank mein kahan se write start hoga: Word 2 standard EPC address hai
    "RfidStartWord": 2,
    // Kitne words write karne hain: 4 words = 8 bytes = 16 hex character standard EPC
    "RfidWordCount": 4,
    // Baaki bache hue aage ke RFID memory words ko zero se saaf karna ho toh true
    "RfidClearTrailingEpcWords": false,
    // Total tag capacity words mein jab trailing words clear karne hon
    "RfidTotalEpcWordsToClear": 6,
    // Protocol Control (PC) word saath write karna hai taaki tag reliable read ho sake
    "UseEpcBankWriteFormat": true,
    // Barcode string ko hex samajhna hai: "Always" valid hex ko hex rakhta hai
    "RfidHexInputMode": "Always",
    // Do print jobs ke beech printer buffer clear hone ka time milliseconds mein
    "InterJobDelayMs": 500,
    // Printer ko bheja gaya raw ZPL code file mein save karke dekhne ke liye true rakhein
    "DumpZplToFile": true,
    // ZPL code save hone ki file ka path (jaise zpl-dump.txt)
    "DumpZplPath": "P:\\write_test\\publish_latest_agent\\zpl-dump.txt"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
