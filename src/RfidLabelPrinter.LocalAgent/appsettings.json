{
  "AgentSettings": {
    // Backend Cloud API base URL used to claim pending print jobs and report status
    "CloudApiUrl": "http://180.151.91.194:7000/api/print-jobs",
    // Network IP address of your Zebra RFID barcode printer
    "PrinterIp": "192.168.29.180",
    // TCP network port of the Zebra printer (Standard is 9100)
    "PrinterPort": 9100,
    // Time in milliseconds to wait between polling cycles for new print jobs
    "PollingIntervalMs": 300,
    // Number of print jobs to claim and process in a single batch
    "ClaimBatchSize": 1,
    // Maximum number of continuous claim loops to run before brief polling pause
    "ClaimMaxLoopsPerCycle": 10,
    // Set to true to write EPC data into UHF RFID tags; set to false for print-only
    "EnableRfidWrite": true,
    // Resolution of your Zebra printer head in Dots Per Inch (Configured for 300 DPI)
    "PrinterDpi": 300,
    // Physical total width of your label in dots (1181 dots = 100mm at 300 DPI)
    "LabelWidthDots": 1181,
    // Physical total length of your label in dots (591 dots = 50mm at 300 DPI)
    "LabelLengthDots": 591,
    // Horizontal offset in dots (725 dots places 55% design in middle of right flap at 300 DPI)
    "PrintOffsetX": 725,
    // Vertical offset in dots (135 dots places 55% design vertically centered in 50mm flap at 300 DPI)
    "PrintOffsetY": 135,
    // Automatically print single-sided labels on lower flap near jewelry tail (true = auto lower flap, false = use PrintOffsetY)
    "SingleSidePrintOnLowerFlap": true,
    // Manual vertical offset for single-sided labels in dots (0 = auto calculate lower flap position)
    "SingleSideOffsetY": 0,
    // Printable flap width in dots (Set to 0 to automatically use right flap width)
    "PrintAreaWidthDots": 0,
    // Printable flap height in dots (Set to 0 to automatically use full label height)
    "PrintAreaHeightDots": 0,
    // Set to true to auto-center; set to false to directly use PrintOffsetX and PrintOffsetY parameters
    "AutoCenterOnFlap": false,
    // Sizing scale percentage of design within flap area (55% produces compact centered design with ~11mm margins)
    "PdfSizePercent": 55,
    // Automatically trims empty white borders around PDF content so text starts cleanly without margin
    "AutoTrimWhitespace": true,
    // Set to true to render PDF as high-resolution graphics; false uses text extraction
    "PrintPdfAsGraphics": true,
    // Set to true to prefer native text extraction over graphics rendering when possible
    "PreferPdfTextToZpl": false,
    // Manual Zebra physical feed adjustment in dots (Valid hardware range is -120 to +120 dots)
    "LabelTopShiftDots": 0,
    // Rendering DPI used to convert incoming PDF vector pages into high-resolution bitmap (300 is sharpest)
    "PdfRenderDpi": 300,
    // Grayscale threshold (0-255): Pixels with average color below this are treated as solid black ink
    "BlackThreshold": 240,
    // Alpha opacity threshold (0-255): Pixels with opacity above this are considered printable ink
    "AlphaThreshold": 5,
    // Number of retry attempts when downloading PDF labels from remote HTTP URL
    "PdfDownloadRetryCount": 5,
    // Delay in milliseconds between PDF download retry attempts upon failure
    "PdfDownloadRetryDelayMs": 800,
    // RFID encoding mode: "H" for Hexadecimal payload (Standard), "A" for ASCII text payload
    "RfidMode": "H",
    // RFID memory bank number: 1 = EPC memory bank (Standard Gen2 RFID specification)
    "RfidBlockNumber": 1,
    // Starting 16-bit word address in EPC bank (Word 2 is where standard EPC barcode starts)
    "RfidStartWord": 2,
    // Number of 16-bit EPC words to write (Word count: 4 words = 8 bytes = 16 hex characters)
    "RfidWordCount": 4,
    // Set to true to overwrite unused trailing EPC words with zeros; false leaves existing memory intact
    "RfidClearTrailingEpcWords": false,
    // Total EPC word capacity of your physical RFID tag when clearing trailing memory
    "RfidTotalEpcWordsToClear": 6,
    // Set to true to write Gen2 Protocol Control (PC) word before EPC data for reliable tag reads
    "UseEpcBankWriteFormat": true,
    // How to treat input barcode strings: "Always" treats valid hex as hex; "Never" always converts ASCII to hex
    "RfidHexInputMode": "Always",
    // Delay in milliseconds between consecutive print jobs in a batch to allow printer buffer to clear
    "InterJobDelayMs": 500,
    // Set to true to save generated raw ZPL commands to a local text file for verification and debugging
    "DumpZplToFile": true,
    // Full absolute file path where raw ZPL commands will be logged when DumpZplToFile is enabled
    "DumpZplPath": "P:\\write_test\\publish_latest_agent\\zpl-dump.txt"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}